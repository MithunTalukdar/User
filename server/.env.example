
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_resume_builder
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# --- Email / OTP ---
# When SMTP_HOST/SMTP_USER/SMTP_PASS are set, real emails are sent via nodemailer.
# Otherwise OTPs are logged to the server console (dev fallback) and echoed as debugOtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mithuntalukdar2003@gmail.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM="AI Resume Builder"

OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_CODE_LENGTH=6


OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-latest


MOCK_AI=true
